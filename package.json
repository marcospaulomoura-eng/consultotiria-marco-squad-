{
  "name": "marco-squad-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:supabase": "node --env-file-if-exists=.env scripts/dev.mjs --supabase",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test server/*.test.mjs cloudflare/*.test.mjs scripts/*.test.mjs",
    "start": "node server/index.mjs",
    "start:supabase": "node --env-file-if-exists=.env server/supabase-local.mjs",
    "supabase:migrate": "node --env-file-if-exists=.env scripts/migrate-supabase.mjs",
    "supabase:import": "node --env-file-if-exists=.env scripts/import-supabase.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "cloud:dev": "node scripts/wrangler.mjs dev --ip 127.0.0.1 --port 8787",
    "cloud:migrate:local": "node scripts/wrangler.mjs d1 migrations apply DB --local",
    "cloud:check": "node scripts/wrangler.mjs deploy --dry-run --outdir .wrangler/check",
    "cloud:deploy": "npm run build && node scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "express": "5.1.0",
    "lucide-react": "1.59.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "wrangler": "4.151.2"
  },
  "engines": {
    "node": "24.x"
  }
}
