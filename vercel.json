{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "server/*.json"
    }
  },
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api/index.mjs" },
    { "handle": "filesystem" },
    { "src": "/(?:assets|brand|videos)/.*", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/whatsapp", "schedule": "0 12 * * *" }
  ]
}
